rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Products collection:
    // Anyone can read catalog products
    // Authenticated users and store admin can create, update, and delete products
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Orders collection:
    // Anyone can create a customer order
    // Order management allowed for store operations
    match /orders/{orderId} {
      allow read: if true;
      allow create: if request.resource.data.customer != null && request.resource.data.phone != null;
      allow update, delete: if true;
    }

    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
